#!/bin/sh
# Auto-formats backend sources (Google Java Style via Spotless) before each
# commit and re-stages any files it touches.
set -e

repo_root="$(git rev-parse --show-toplevel)"

if [ -d "$repo_root/backend" ]; then
  (cd "$repo_root/backend" && ./gradlew spotlessApply -q)
  git -C "$repo_root" add -u backend
fi
